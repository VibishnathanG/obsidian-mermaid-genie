{
  "name": "obsidian-mermaid-genie",
  "version": "1.0.0",
  "description": "Smart, beautiful Mermaid flowcharts for Obsidian with coordinated colored flow blocks, aligned branches, ancestor path highlighting, crisp typography, and diagram export.",
  "main": "main.js",
  "scripts": {
    "build": "tsx esbuild.config.mts",
    "dev": "tsx esbuild.config.mts --watch",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "mermaid",
    "flowchart",
    "diagram",
    "colors",
    "styling"
  ],
  "author": "Vibish <https://github.com/VibishnathanG>",
  "repository": {
    "type": "git",
    "url": "https://github.com/VibishnathanG/obsidian-mermaid-genie.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.13.0",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.3",
    "mermaid": "^12.2.0",
    "obsidian": "^1.14.4",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "pele": "^1.10.0"
  }
}
